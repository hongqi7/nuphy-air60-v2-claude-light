+/**
+ * @brief  Claude Code status from host LEDs (Mac mode only).
+ *         Num Lock    -> working   (orange, 2 s breath)
+ *         Scroll Lock -> done      (green, 3 s breath)
+ *         both        -> needs you (blue, 1.2 s breath)
+ *         Same colours and timing as the Agent Lumen screen glow.
+ */
+#define CLAUDE_IDLE         0
+#define CLAUDE_WORKING      1
+#define CLAUDE_DONE         2
+#define CLAUDE_ATTENTION    3
+#define CLAUDE_MIN_LIGHT    3
+
+// breath length per state, indexed by the values above
+static const uint16_t claude_period_ms[] = { 1, 2000, 3000, 1200 };
+
+uint8_t claude_state(void)
+{
+    bool num, scroll;
+
+    if (dev_info.sys_sw_state != SYS_SW_MAC) return CLAUDE_IDLE;
+
+    if (dev_info.link_mode == LINK_USB) {
+        num    = host_keyboard_led_state().num_lock;
+        scroll = host_keyboard_led_state().scroll_lock;
+    } else {
+        if (dev_info.rf_state != RF_CONNECT) return CLAUDE_IDLE;
+        num    = dev_info.rf_led & 0x01;
+        scroll = dev_info.rf_led & 0x04;
+    }
+
+    if (num && scroll) return CLAUDE_ATTENTION;
+    if (num) return CLAUDE_WORKING;
+    if (scroll) return CLAUDE_DONE;
+    return CLAUDE_IDLE;
+}
+
+bool claude_keep_awake(void)
+{
+    uint8_t state = claude_state();
+    return state == CLAUDE_WORKING || state == CLAUDE_ATTENTION;
+}
+
+// scale a channel by level/255 with rounding, so the colour ratio holds at any brightness
+static uint8_t claude_scale(uint8_t c, uint8_t level)
+{
+    return ((uint16_t)c * level + 127) / 255;
+}
+
+/**
+ * Settings from Agent Lumen, sent over USB raw HID (the wireless module forwards only the lock bits):
+ *   'L' 'M' 0x01 <working> <done> <needs you> <flags>   set brightness per state (0-255) and flags
+ *   'L' 'M' 0x02                                         read them back
+ * The reply echoes the command with the current values and the protocol version in byte 7.
+ * Kept in the user EEPROM block, saved 2 s after the last change so a dragged slider doesn't wear it.
+ */
+#define CLAUDE_CFG_MAGIC    0xA0
+#define CLAUDE_CFG_GLOBAL   0x01
+
+static bool     claude_dirty      = false;
+static uint32_t claude_save_timer = 0;
+
+static bool claude_cfg_set(void)
+{
+    return (user_config.claude_flags & ~CLAUDE_CFG_GLOBAL) == CLAUDE_CFG_MAGIC;
+}
+
+bool via_command_kb(uint8_t *data, uint8_t length)
+{
+    if (length < 8 || data[0] != 'L' || data[1] != 'M') return false;
+
+    if (data[2] == 0x01) {
+        for (uint8_t i = 0; i < 3; i++) user_config.claude_level[i] = data[3 + i];
+        user_config.claude_flags = CLAUDE_CFG_MAGIC | (data[6] & CLAUDE_CFG_GLOBAL);
+        claude_dirty      = true;
+        claude_save_timer = timer_read32();
+    }
+    bool set = claude_cfg_set();
+    for (uint8_t i = 0; i < 3; i++) data[3 + i] = set ? user_config.claude_level[i] : 0;
+    data[6] = set ? user_config.claude_flags & CLAUDE_CFG_GLOBAL : 0;
+    data[7] = 1;
+    raw_hid_send(data, length);
+    return true;
+}
+
+// the state's colour at this moment of its breath; false when idle
+static bool claude_colour(uint8_t state, uint8_t *r, uint8_t *g, uint8_t *b)
+{
+    uint8_t level, point;
+
+    if (state == CLAUDE_IDLE) return false;
+
+    // these LEDs have a strong green die: 0xff,0x40,0x00 already reads as yellow,
+    // so Claude orange needs very little green
+    if (state == CLAUDE_WORKING) {
+        *r = 0xff; *g = 0x14; *b = 0x03;
+    } else if (state == CLAUDE_DONE) {
+        *r = 0x00; *g = 0xff; *b = 0x00;
+    } else {
+        *r = 0x00; *g = 0x40; *b = 0xff;
+    }
+
+    if (claude_cfg_set()) {
+        level = user_config.claude_level[state - 1];
+    } else {
+        level = side_light_table[side_light > CLAUDE_MIN_LIGHT ? side_light : CLAUDE_MIN_LIGHT];
+    }
+    // breathe between 35% and 100% (near zero the small green value rounds away and the hue drifts);
+    // the phase comes from the clock, so the speed doesn't depend on how often this runs
+    point = (uint32_t)(timer_read32() % claude_period_ms[state]) * BREATHE_TAB_LEN / claude_period_ms[state];
+    level = claude_scale(level, 89 + claude_scale(166, breathe_data_tab[point]));
+
+    *r = claude_scale(*r, level);
+    *g = claude_scale(*g, level);
+    *b = claude_scale(*b, level);
+    return true;
+}
+
+static void claude_led_show(void)
+{
+    uint8_t r, g, b;
+
+    if (claude_dirty && timer_elapsed32(claude_save_timer) > 2000) {
+        claude_dirty = false;
+        eeconfig_update_user_datablock(&user_config);
+    }
+
+    if (!claude_colour(claude_state(), &r, &g, &b)) return;
+    set_left_rgb(r, g, b);
+    set_right_rgb(r, g, b);
+}
+
+// optional: the key backlight breathes too; called after the RGB effect has drawn the frame
+void claude_keys_show(void)
+{
+    uint8_t r, g, b;
+
+    if (!claude_cfg_set() || !(user_config.claude_flags & CLAUDE_CFG_GLOBAL)) return;
+    if (!claude_colour(claude_state(), &r, &g, &b)) return;
+    for (uint8_t i = 0; i < SIDE_INDEX; i++) rgb_matrix_set_color(i, r, g, b);
+}
